# Copy to .env next to docker-compose.yml and adjust.

SIESTA_IMAGE=balaktsis/siesta:latest

# ---- Ports -------------------------------------------------------------------
# A service is reachable from outside the container only if its port is set here
# (it then listens on 0.0.0.0:<port>). Unset = internal only (127.0.0.1).
# With the default bridge network, also add the matching mapping under `ports:`
# in docker-compose.yml (the API's is already there).
SIESTA_API_PORT=8000
SIESTA_SPARK_UI_PORT=
SIESTA_SPARK_MASTER_PORT=
SIESTA_SPARK_MASTER_UI_PORT=
SIESTA_SPARK_WORKER_UI_PORT=
SIESTA_MINIO_PORT=
SIESTA_MINIO_CONSOLE_PORT=

# ---- MinIO credentials (Siesta uses the same ones). CHANGE THESE. --------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- Spark sizing ----------------------------------------------------------------
# Rough RAM need: DRIVER_MEMORY + WORKER_MEMORY + 2 x DAEMON_MEMORY + ~1g
# Executors per worker = min(WORKER_CORES / EXECUTOR_CORES,
#                            WORKER_MEMORY / (EXECUTOR_MEMORY + EXECUTOR_MEMORY_OVERHEAD))
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=8g
SPARK_DAEMON_MEMORY=1g
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_CORES=2
SPARK_EXECUTOR_MEMORY=3g
SPARK_EXECUTOR_MEMORY_OVERHEAD=512m
SPARK_CORES_MAX=
SPARK_SHUFFLE_PARTITIONS=

# ---- Distributed execution (external Spark workers) ------------------------------
# Address external executors use to reach the driver, and fixed driver ports so
# they can be published. Leave unset for single-container use.
SPARK_DRIVER_HOST=
SPARK_DRIVER_PORT=
SPARK_BLOCKMANAGER_PORT=
